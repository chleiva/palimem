{
  "id": "tb-01-llm-supplied-origin-and-source",
  "title": "LLM-supplied origin and source are stripped; report is an agent_statement",
  "covers": [
    "R1",
    "R2",
    "R3"
  ],
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "inertia": "forever",
        "completeness": "open"
      },
      "hq_city": {
        "class": "single_changeable",
        "inertia": "forever",
        "completeness": "open"
      },
      "salary": {
        "class": "single_changeable",
        "inertia": "forever",
        "completeness": "open"
      }
    },
    "connectors": {
      "conn:user": {
        "source_id": "src:user",
        "source_class": "trusted",
        "origin_group": "g_user",
        "kind": "user_message",
        "principal": "user:alice"
      },
      "conn:web": {
        "source_id": "src:web",
        "source_class": "low",
        "origin_group": "g_web",
        "kind": "tool_result"
      },
      "conn:registry": {
        "source_id": "src:registry",
        "source_class": "trusted",
        "origin_group": "g_registry",
        "kind": "feed"
      },
      "conn:quarantined": {
        "source_id": "src:q1",
        "source_class": "quarantined",
        "origin_group": "g_q",
        "kind": "feed"
      }
    },
    "authority": [],
    "session": {
      "session_id": "s2",
      "agent_principal": "agent:a1",
      "end_user_principal": "user:alice",
      "allowed_attrs": [
        "employer",
        "hq_city"
      ],
      "policy_version": "p-default",
      "max_explanation_budget": 50
    },
    "events": [],
    "log": [],
    "now": "2026-10-02T09:00:00Z"
  },
  "steps": [
    {
      "tier": "agent",
      "call": "remember",
      "args": {
        "text": "Alice works at Globex",
        "origin": "external_observation",
        "source": "src:registry"
      }
    }
  ],
  "expect": {
    "steps": [
      {
        "result": {
          "origin": "agent_statement",
          "admitted": false,
          "notices": [
            {
              "code": "field_ignored",
              "field": "origin"
            },
            {
              "code": "field_ignored",
              "field": "source"
            }
          ]
        }
      }
    ],
    "log_delta": [
      {
        "origin": "agent_statement",
        "source": {
          "id": "agent:a1",
          "class": "agent"
        },
        "actor": "agent:a1",
        "origin_group": "agent:a1",
        "cue": "assert"
      }
    ],
    "audit_delta": [
      {
        "event": "trust_downgrade",
        "tool": "remember",
        "fields": [
          "origin",
          "source"
        ]
      }
    ],
    "answers": [
      {
        "query": {
          "kind": "belief",
          "key": [
            "alice",
            "employer"
          ]
        },
        "match": {
          "kernel_status": "unknown"
        }
      }
    ]
  }
}
