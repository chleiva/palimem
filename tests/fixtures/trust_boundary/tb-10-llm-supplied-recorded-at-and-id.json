{
  "id": "tb-10-llm-supplied-recorded-at-and-id",
  "title": "Caller-supplied recorded_at and id are ignored; LSN order wins",
  "covers": [
    "R1"
  ],
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "inertia": true,
        "completeness": "open"
      },
      "hq_city": {
        "class": "single_changeable",
        "inertia": true,
        "completeness": "open"
      },
      "salary": {
        "class": "single_changeable",
        "inertia": true,
        "completeness": "open"
      }
    },
    "connectors": {
      "conn:user": {
        "source_id": "src:user",
        "source_class": "trusted",
        "origin_group": "g_user",
        "kind": "user_message",
        "principal": "user:alice"
      },
      "conn:web": {
        "source_id": "src:web",
        "source_class": "low",
        "origin_group": "g_web",
        "kind": "tool_result"
      },
      "conn:registry": {
        "source_id": "src:registry",
        "source_class": "trusted",
        "origin_group": "g_registry",
        "kind": "feed"
      },
      "conn:quarantined": {
        "source_id": "src:q1",
        "source_class": "quarantined",
        "origin_group": "g_q",
        "kind": "feed"
      }
    },
    "authority": [],
    "session": {
      "session_id": "s2",
      "agent_principal": "agent:a1",
      "end_user_principal": "user:alice",
      "allowed_attrs": [
        "employer",
        "hq_city"
      ],
      "policy_version": "p-default",
      "max_explanation_budget": 50
    },
    "events": [],
    "log": [
      {
        "ref": "r1",
        "key": [
          "acme",
          "hq_city"
        ],
        "proposition": {
          "form": "value",
          "v": "London"
        },
        "cue": "assert",
        "origin": "external_observation",
        "source": {
          "id": "src:registry",
          "class": "trusted"
        },
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "recorded_at": "2026-09-01T10:00:00Z"
      }
    ],
    "now": "2026-10-02T09:00:00Z"
  },
  "steps": [
    {
      "tier": "agent",
      "call": "remember",
      "args": {
        "text": "Alice works at Globex",
        "recorded_at": "2020-01-01T00:00:00Z",
        "id": "r1"
      }
    }
  ],
  "expect": {
    "steps": [
      {
        "result": {
          "notices": [
            {
              "code": "field_ignored",
              "field": "recorded_at"
            },
            {
              "code": "field_ignored",
              "field": "id"
            }
          ]
        }
      }
    ],
    "log_delta": [
      {
        "id": "$not:r1",
        "recorded_at": "$after:2026-09-01T10:00:00Z",
        "lsn": "$gt:$r1.lsn"
      }
    ],
    "answers": [
      {
        "query": {
          "kind": "belief",
          "key": [
            "acme",
            "hq_city"
          ],
          "belief_as_of": "$r1.lsn"
        },
        "match": {
          "kernel_status": "established"
        }
      }
    ]
  }
}
