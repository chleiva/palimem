{
  "id": "tb-06-cite-unknown-event",
  "title": "An unknown or foreign event id writes nothing",
  "covers": [
    "R5",
    "R7"
  ],
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "inertia": true,
        "completeness": "open"
      },
      "hq_city": {
        "class": "single_changeable",
        "inertia": true,
        "completeness": "open"
      },
      "salary": {
        "class": "single_changeable",
        "inertia": true,
        "completeness": "open"
      }
    },
    "connectors": {
      "conn:user": {
        "source_id": "src:user",
        "source_class": "trusted",
        "origin_group": "g_user",
        "kind": "user_message",
        "principal": "user:alice"
      },
      "conn:web": {
        "source_id": "src:web",
        "source_class": "low",
        "origin_group": "g_web",
        "kind": "tool_result"
      },
      "conn:registry": {
        "source_id": "src:registry",
        "source_class": "trusted",
        "origin_group": "g_registry",
        "kind": "feed"
      },
      "conn:quarantined": {
        "source_id": "src:q1",
        "source_class": "quarantined",
        "origin_group": "g_q",
        "kind": "feed"
      }
    },
    "authority": [],
    "session": {
      "session_id": "s2",
      "agent_principal": "agent:a1",
      "end_user_principal": "user:alice",
      "allowed_attrs": [
        "employer",
        "hq_city"
      ],
      "policy_version": "p-default",
      "max_explanation_budget": 50
    },
    "events": [],
    "log": [],
    "now": "2026-10-02T09:00:00Z"
  },
  "steps": [
    {
      "tier": "agent",
      "call": "remember",
      "args": {
        "text": "Alice works at Globex",
        "cite_event": "evt-999"
      }
    }
  ],
  "expect": {
    "steps": [
      {
        "result": {
          "report_ids": [],
          "notices": [
            {
              "code": "event_unknown"
            }
