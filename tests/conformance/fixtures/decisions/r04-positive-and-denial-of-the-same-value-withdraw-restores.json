{
  "version": 1,
  "kind": "scenario",
  "id": "r04-positive-and-denial-of-the-same-value-withdraw-restores",
  "title": "A positive and a denial of the same value are unresolved with both readings; withdrawing the denial restores the positive",
  "gate": "G1",
  "area": "negative_evidence",
  "status": "active",
  "covers": [
    "ruling-4",
    "design-row-13"
  ],
  "requires": [],
  "spec_dependencies": [],
  "why": "r1 (registry) affirms Acme, r2 (press) denies it: they conflict, an interpretation may label only one TRUE, and either may be wrong (A-ERR), so the key is unresolved with both readings as candidates (value acme, not_value acme), one environment each, and the policy asks. The press withdraws its own denial: the positive alone decides (established Acme). The history is kept: at r2's position the key was unresolved.",
  "source": "docs/decisions/RULINGS-2026-10-05.md items 11, 12",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "not_value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q_both",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "unresolved",
        "decision": "ask",
        "_candidates": {
          "$unordered": [
            {
              "form": {
                "form": "value",
                "v": "acme"
              }
            },
            {
              "form": {
                "form": "not_value",
                "v": "acme"
              }
            }
          ]
        },
        "_environments": {
          "$unordered": [
            {
              "$unordered": [
                "$r1"
              ]
            },
            {
              "$unordered": [
                "$r2"
              ]
            }
          ]
        }
      }
    },
    {
      "op": "append",
      "ref": "r3",
      "at": "2026-02-10T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": null,
        "cue": "withdraw",
        "target": "$r2",
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q_after",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "established",
        "decision": "commit",
        "assertion": {
          "form": {
            "form": "value",
            "v": "acme"
          }
        }
      }
    },
    {
      "op": "query",
      "name": "q_history",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "belief_as_of": "$r2.lsn"
      },
      "expect": {
        "kernel_status": "unresolved",
        "_candidates": {
          "$len": 2
        }
      }
    }
  ]
}
