{
  "version": 1,
  "kind": "scenario",
  "id": "r02-exclude-source-from-lsn-scopes-the-decision",
  "title": "from_lsn scopes the exclusion to the source's reports at or after that position",
  "gate": "G1",
  "area": "admission",
  "status": "active",
  "covers": [
    "ruling-2"
  ],
  "requires": [
    "source_exclusion"
  ],
  "spec_dependencies": [],
  "why": "The press reports about alice (r1, position 1) and about bob (r2, position 2). The host excludes the press from r2's position on: alice's employer, reported before from_lsn, is still heard (established Acme); bob's, at the position, is not (unknown).",
  "source": "docs/decisions/RULINGS-2026-10-05.md item 2",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "bob",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "globex"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "exclude_source",
      "source": "press",
      "from_lsn": "$r2.lsn",
      "reason": "the feed went bad at the second report"
    },
    {
      "op": "query",
      "name": "q_alice",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "acme"
          }
        }
      }
    },
    {
      "op": "query",
      "name": "q_bob",
      "query": {
        "key": {
          "entity": "bob",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "unknown"
      }
    }
  ]
}
