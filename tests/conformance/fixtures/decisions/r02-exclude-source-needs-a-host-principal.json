{
  "version": 1,
  "kind": "scenario",
  "id": "r02-exclude-source-needs-a-host-principal",
  "title": "Only a system: or user: principal can exclude a source; an agent's or a connector's attempt is refused",
  "gate": "G1",
  "area": "security",
  "status": "active",
  "covers": [
    "ruling-2",
    "T-02"
  ],
  "requires": [
    "source_exclusion"
  ],
  "spec_dependencies": [],
  "why": "Which sources are heard is the host's decision. An exclude_source by an agent principal or a connector is refused (nothing is logged) and the source is still heard.",
  "source": "docs/decisions/RULINGS-2026-10-05.md item 2",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "exclude_source",
      "source": "press",
      "from_lsn": 1,
      "reason": "an agent decided",
      "actor": "agent:planner",
      "expect": {
        "error": {
          "code": "ExclusionNotHonoured"
        }
      }
    },
    {
      "op": "exclude_source",
      "source": "press",
      "from_lsn": 1,
      "reason": "a connector decided",
      "actor": "connector:press",
      "expect": {
        "error": {
          "code": "ExclusionNotHonoured"
        }
      }
    },
    {
      "op": "query",
      "name": "q1",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "acme"
          }
        }
      }
    }
  ]
}
