{
  "version": 1,
  "kind": "scenario",
  "id": "r07-strict-rules-stay",
  "title": "A strict rule (no exceptions) derives as before in the product profile",
  "gate": "G1",
  "area": "rules",
  "status": "active",
  "covers": [
    "ruling-10",
    "S-10"
  ],
  "requires": [],
  "spec_dependencies": [],
  "why": "Strict rules are what 0.x keeps: work_city(alice) reads employer(alice) and hq_city(veltran) with no exception; with both reports present it is established Tessaly, and withdrawing the employer report removes it.",
  "source": "docs/decisions/RULINGS-2026-10-05.md item 10",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      },
      "hq_city": {
        "class": "single_stable",
        "value_type": "entity",
        "inertia": false
      },
      "work_city": {
        "class": "derived",
        "value_type": "entity",
        "inertia": false,
        "rule": {
          "reads": [
            "employer",
            "hq_city"
          ],
          "fn": "work_city(e,c) <- employer(e,x), hq_city(x,c)"
        }
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "veltran"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "veltran",
          "attr": "hq_city"
        },
        "proposition": {
          "form": "value",
          "v": "tessaly"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q1",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "work_city"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "tessaly"
          }
        }
      }
    },
    {
      "op": "append",
      "ref": "r3",
      "at": "2026-02-10T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": null,
        "cue": "withdraw",
        "target": "$r1",
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q2",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "work_city"
        }
      },
      "expect": {
        "kernel_status": "unknown"
      }
    }
  ]
}
