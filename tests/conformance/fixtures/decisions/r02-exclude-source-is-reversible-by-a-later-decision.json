{
  "version": 1,
  "kind": "scenario",
  "id": "r02-exclude-source-is-reversible-by-a-later-decision",
  "title": "A restore is a later recorded decision that lifts the exclusion; nothing is rewritten",
  "gate": "G1",
  "area": "admission",
  "status": "active",
  "covers": [
    "ruling-2"
  ],
  "requires": [
    "source_exclusion"
  ],
  "spec_dependencies": [],
  "why": "After the exclusion of r02-exclude-source-removes-earlier-and-later-reports the host decides the alarm was false and restores the press from position 1. The press's report is heard again: with only the press and no other source, alice's employer is established Acme.",
  "source": "docs/decisions/RULINGS-2026-10-05.md item 2",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "exclude_source",
      "source": "press",
      "from_lsn": 1,
      "reason": "suspected compromise"
    },
    {
      "op": "query",
      "name": "q_excluded",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "unknown"
      }
    },
    {
      "op": "restore_source",
      "source": "press",
      "from_lsn": 1,
      "reason": "false alarm: the feed was verified"
    },
    {
      "op": "query",
      "name": "q_restored",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "acme"
          }
        }
      }
    }
  ]
}
