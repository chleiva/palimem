{
  "version": 1,
  "kind": "scenario",
  "id": "s12-01-depth-three-derivation-withdraw-at-leaf",
  "title": "A three-deep derivation lists its leaf in explain(depth=None); withdrawing the leaf removes the conclusion",
  "gate": "G1",
  "area": "provenance",
  "status": "active",
  "covers": [
    "S-12"
  ],
  "requires": [],
  "spec_dependencies": [],
  "why": "local_tax_city(alice) rests on work_city, which rests on employer and hq_city: three derivation levels above the base reports. With depth=None (the full closure) the explanation lists the base reports r1 and r2 (derivation pins are explanatory, not evidence). Withdrawing the leaf r1 removes the conclusion.",
  "source": "S-12 decision (accepted 2026-10-04)",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      },
      "hq_city": {
        "class": "single_stable",
        "value_type": "entity",
        "inertia": false
      },
      "work_city": {
        "class": "derived",
        "value_type": "entity",
        "inertia": false,
        "rule": {
          "reads": [
            "employer",
            "hq_city"
          ],
          "fn": "work_city(e,c) <- employer(e,x), hq_city(x,c)"
        }
      },
      "local_tax_city": {
        "class": "derived",
        "value_type": "entity",
        "inertia": false,
        "rule": {
          "reads": [
            "work_city"
          ],
          "fn": "local_tax_city(e,c) <- work_city(e,c)"
        }
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "veltran"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "veltran",
          "attr": "hq_city"
        },
        "proposition": {
          "form": "value",
          "v": "tessaly"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "explain",
      "name": "ex1",
      "key": {
        "entity": "alice",
        "attr": "local_tax_city"
      },
      "mode": "all",
      "depth": null,
      "expect": {
        "state": "complete",
        "environments": {
          "$unordered": [
            {
              "$unordered": [
                "$r1",
                "$r2"
              ]
            }
          ]
        }
      }
    },
    {
      "op": "append",
      "ref": "r3",
