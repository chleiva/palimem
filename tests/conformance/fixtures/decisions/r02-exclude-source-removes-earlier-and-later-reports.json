{
  "version": 1,
  "kind": "scenario",
  "id": "r02-exclude-source-removes-earlier-and-later-reports",
  "title": "exclude_source removes the source's earlier reports AND the ones logged after the decision (the late-assert class)",
  "gate": "G1",
  "area": "admission",
  "status": "active",
  "covers": [
    "ruling-2",
    "S-03"
  ],
  "requires": [
    "source_exclusion"
  ],
  "spec_dependencies": [],
  "why": "A source going bad is an admission operation: the contract has no source-scope withdraw. The press says Acme (r1), the registry says Globex (r2): unresolved. The host excludes the press from log position 1 with a reason. The press's earlier report leaves the evidence set (repaired like a withdrawal): employer is established Globex with environment {r2}. The press then reports Initech (r3, the paper's 'later assertion'): a per-report withdraw could not reach a report that did not exist yet, the exclusion does, so the answer stays Globex. The history is preserved: a belief_as_of query at r2's position still shows what was believed then (unresolved {Acme, Globex}). Nothing was deleted: r1 is still in the log.",
  "source": "docs/decisions/RULINGS-2026-10-05.md item 2",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "globex"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q_before",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "unresolved",
        "_candidates": {
          "$unordered": [
            {
              "form": {
                "form": "value",
                "v": "acme"
              }
            },
            {
              "form": {
                "form": "value",
                "v": "globex"
              }
            }
          ]
        }
      }
    },
    {
      "op": "exclude_source",
      "name": "x1",
      "source": "press",
      "from_lsn": 1,
      "reason": "the press feed was hijacked",
      "expect": {
        "admission": {
          "outcome": "admissible"
        }
      }
    },
    {
      "op": "query",
      "name": "q_after",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "globex"
          }
        },
        "_environments": {
          "$unordered": [
            {
              "$unordered": [
                "$r2"
              ]
            }
          ]
        }
      }
    },
    {
      "op": "append",
      "ref": "r3",
      "at": "2026-02-10T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "initech"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q_late",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "globex"
          }
        },
        "_environments": {
          "$unordered": [
            {
              "$unordered": [
                "$r2"
              ]
            }
          ]
        }
      }
    },
    {
      "op": "query",
      "name": "q_history",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "belief_as_of": "$r2.lsn"
      },
      "expect": {
        "kernel_status": "unresolved",
        "_candidates": {
          "$unordered": [
            {
              "form": {
                "form": "value",
                "v": "acme"
              }
            },
            {
              "form": {
                "form": "value",
                "v": "globex"
              }
            }
          ]
        }
      }
    },
    {
      "op": "reports",
      "name": "rep_r1",
      "filter": {
        "id": "$r1"
      },
      "expect": {
        "rows": [
          {
            "id": "$r1"
          }
        ]
      }
    }
  ]
}
