{
  "version": 1,
  "kind": "scenario",
  "id": "s12-02-explain-depth-one-truncated-marker",
  "title": "explain(depth=1) on a deeper derivation is marked truncated; the answer is unchanged",
  "gate": "G1",
  "area": "provenance",
  "status": "active",
  "covers": [
    "S-12"
  ],
  "requires": [],
  "spec_dependencies": [],
  "why": "A depth smaller than the derivation depth cuts the explanation and must say so (state=truncated) rather than silently listing fewer reports as if complete. The query's kernel_status, decision and assertion are not affected by how deep the caller asks to explain.",
  "source": "S-12 decision (accepted 2026-10-04)",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      },
      "hq_city": {
        "class": "single_stable",
        "value_type": "entity",
        "inertia": false
      },
      "work_city": {
        "class": "derived",
        "value_type": "entity",
        "inertia": false,
        "rule": {
          "reads": [
            "employer",
            "hq_city"
          ],
          "fn": "work_city(e,c) <- employer(e,x), hq_city(x,c)"
        }
      },
      "local_tax_city": {
        "class": "derived",
        "value_type": "entity",
        "inertia": false,
        "rule": {
          "reads": [
            "work_city"
          ],
          "fn": "local_tax_city(e,c) <- work_city(e,c)"
        }
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "veltran"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "veltran",
          "attr": "hq_city"
        },
        "proposition": {
          "form": "value",
          "v": "tessaly"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q_plain",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "local_tax_city"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "tessaly"
          }
        }
      }
    },
    {
      "op": "explain",
      "name": "ex_d1",
      "key": {
        "entity": "alice",
        "attr": "local_tax_city"
      },
      "mode": "all",
      "depth": 1,
      "expect": {
        "state": "truncated"
      }
    },
    {
      "op": "query",
      "name": "q_after",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "local_tax_city"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "tessaly"
          }
        }
      }
    }
  ],
  "expect": {
    "equal": [
      {
        "a": "q_plain",
        "b": "q_after",
        "fields": [
          "kernel_status",
          "decision",
          "assertion"
        ]
      }
    ]
  }
}
