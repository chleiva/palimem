{
  "version": 1,
  "kind": "scenario",
  "id": "r02-exclude-source-repairs-derived-beliefs",
  "title": "Excluding a source repairs everything that rested on it, two steps downstream",
  "gate": "G1",
  "area": "retraction",
  "status": "active",
  "covers": [
    "ruling-2",
    "design-row-1"
  ],
  "requires": [
    "source_exclusion"
  ],
  "spec_dependencies": [],
  "why": "work_city(alice) derives from employer(alice) (press) and hq_city(veltran) (registry). Before the decision the derived belief is established Tessaly. After the host excludes the press the employer report leaves the evidence set and the derived belief loses its only justification: unknown. hq_city, from the registry, is untouched.",
  "source": "docs/decisions/RULINGS-2026-10-05.md item 2",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      },
      "hq_city": {
        "class": "single_stable",
        "value_type": "entity",
        "inertia": false
      },
      "work_city": {
        "class": "derived",
        "value_type": "entity",
        "inertia": false,
        "rule": {
          "reads": [
            "employer",
            "hq_city"
          ],
          "fn": "work_city(e,c) <- employer(e,x), hq_city(x,c)"
        }
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "veltran"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "veltran",
          "attr": "hq_city"
        },
        "proposition": {
          "form": "value",
          "v": "tessaly"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q_before",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "work_city"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "tessaly"
          }
        }
      }
    },
    {
      "op": "exclude_source",
      "source": "press",
      "from_lsn": 1,
      "reason": "compromised"
    },
    {
      "op": "query",
      "name": "q_after",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "work_city"
        }
      },
      "expect": {
        "kernel_status": "unknown"
      }
    },
    {
      "op": "query",
      "name": "q_registry",
      "query": {
        "key": {
          "entity": "veltran",
          "attr": "hq_city"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "tessaly"
          }
        }
      }
    }
  ]
}
