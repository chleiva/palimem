{
  "version": 1,
  "kind": "scenario",
  "id": "s10-02-exception-unknown-open-unresolved",
  "title": "Rule exception unknown on an open attribute: the derived belief is unresolved",
  "gate": "G1",
  "area": "rules",
  "status": "active",
  "covers": [
    "S-10"
  ],
  "requires": [],
  "spec_dependencies": [
    "Rule has no structured 'exceptions' in palimem.types.Rule (only reads and fn); fixtures name them in fn and in rule.exceptions, which the type must grow (S-10 needs exception attributes to be identifiable)."
  ],
  "why": "remote is open and has no evidence, so 'is alice remote?' is unknown: two worlds (the rule fires, the rule is blocked). The derived belief is unresolved with two candidates, the value (tessaly) and the empty candidate, instead of established on the strength of an unverified absence. S-10 also wants the inquiry to name the exception key as the missing evidence; that depends on the policy choosing ask, so it is not asserted here.",
  "source": "S-10 decision (accepted 2026-10-04)",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      },
      "hq_city": {
        "class": "single_stable",
        "value_type": "entity",
        "inertia": false
      },
      "remote": {
        "class": "single_changeable",
        "value_type": "bool",
        "inertia": true
      },
      "work_city": {
        "class": "derived",
        "value_type": "entity",
        "inertia": false,
        "rule": {
          "reads": [
            "employer",
            "hq_city",
            "remote"
          ],
          "fn": "work_city(e,c) <- employer(e,x), hq_city(x,c) unless remote(e,true)",
          "exceptions": [
            "remote"
          ]
        }
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "veltran"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "veltran",
          "attr": "hq_city"
        },
        "proposition": {
          "form": "value",
          "v": "tessaly"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q1",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "work_city"
        }
      },
      "expect": {
        "kernel_status": "unresolved",
        "_candidates": {
          "$unordered": [
            {
              "form": {
                "form": "value",
                "v": "tessaly"
              }
            },
            {
              "form": {
                "form": "empty"
              }
            }
          ]
        }
      }
    }
  ]
}
