      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q_before",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "acme"
          }
        }
      }
    },
    {
      "op": "append",
      "ref": "r2",
