      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": null,
        "cue": "dispute",
        "target": "$r1",
        "source": {
          "id": "chat",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_chat",
        "actor": "user:alice",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      },
      "expect": {
        "recorded_cue": "dispute",
        "admission": {
          "outcome": "admissible"
        }
      }
    },
    {
