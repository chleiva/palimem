{
  "version": 1,
  "kind": "scenario",
  "id": "sec-40b-trusted-injection-with-change-cue",
  "title": "A change-cued injection from a trusted source against an EARLIER contradicting report is established and marked single-origin",
  "gate": "G1",
  "area": "poisoning",
  "status": "active",
  "covers": [
    "SEC-40",
    "T-17",
    "poisoning-gate-trusted"
  ],
  "requires": [],
  "spec_dependencies": [],
  "why": "The study's attack used change cues. AUTHOR RULING 13 of 2026-10-05 settles the gate wording: an earlier-anchored report does NOT contradict a change-cued claim under P0c (a change says the value was X and is now Y), and only a report anchored at or after the claimed change does. The press says Acme from 1 Jan (r1); the trusted registry then reports Globex with a change cue from 1 Mar (r2). At 15 Mar the key is established Globex (the legitimate update and the injection look identical to the kernel) and, as the gate requires, the commit rests on a single origin group and is visibly marked as such (one environment {r2}). Contrast sec-40a: a report anchored at the SAME time as the claim contradicts it, so the key is unresolved.",
  "source": "docs/THREAT_MODEL.md §7 (SEC-40)",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": "2026-01-01T00:00:00Z",
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-03-05T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "globex"
        },
        "cue": "change",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": "2026-03-01T00:00:00Z",
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q1",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "valid_at": "2026-03-15T00:00:00Z"
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "globex"
          }
        },
        "provenance": {
          "$len": 1
        }
      }
    }
  ]
}
