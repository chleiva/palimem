{
  "version": 1,
  "kind": "scenario",
  "id": "sec-40b-trusted-injection-with-change-cue",
  "title": "A change-cued injection from a trusted source against an EARLIER contradicting report",
  "gate": "G1",
  "area": "poisoning",
  "status": "pending-decision",
  "covers": [
    "SEC-40",
    "T-17",
    "poisoning-gate-trusted"
  ],
  "requires": [],
  "spec_dependencies": [],
  "why": "The study's attack used change cues. Under P0c a report with a change cue is not disputed by competitors anchored strictly earlier, so a legitimate update and an injection look identical: the injected Globex becomes established while the press's EARLIER Acme 'contradicts' it only in the sense of an earlier value. The decided gate wording ('never established while another origin group contradicts it') does not say whether an earlier-anchored report counts. This fixture records P0c's behaviour plus the single-origin marking, and asks the author to settle the wording.",
  "source": "docs/THREAT_MODEL.md §7 (SEC-40)",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": "2026-01-01T00:00:00Z",
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-03-05T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "globex"
        },
        "cue": "change",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": "2026-03-01T00:00:00Z",
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q1",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "valid_at": "2026-03-15T00:00:00Z"
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "globex"
          }
        },
        "provenance": {
          "$len": 1
        }
      }
    }
  ],
  "status_reason": "Gate wording undecided for earlier-anchored contradictions under P0c cue shielding (see why)."
}
