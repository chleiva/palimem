{
  "version": 1,
  "kind": "scenario",
  "id": "sec-39b-second-origin-group-raises-it",
  "title": "Confirmation by a second origin group is the only way above single-origin",
  "gate": "G1",
  "area": "poisoning",
  "status": "active",
  "covers": [
    "SEC-39",
    "T-17"
  ],
  "requires": [],
  "spec_dependencies": [
    "Whether a same-group copy appears as its own environment or is folded into the group's is S-06 / collapsing territory; this fixture assumes it is folded (counts once)."
  ],
  "why": "Same value from a second, independent origin group: the answer now has two environments {r1} and {r2}, so it is no longer single-origin. A second report from the SAME origin group does not raise it: it would only add a copy.",
  "source": "docs/THREAT_MODEL.md §7 (SEC-39)",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q_one",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "_environments": {
          "$unordered": [
            {
              "$unordered": [
                "$r1"
              ]
            }
          ]
        }
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry2",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q_same_group",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "_environments": {
          "$unordered": [
            {
              "$unordered": [
                "$r1"
              ]
            }
          ]
        }
      }
    },
    {
      "op": "append",
      "ref": "r3",
      "at": "2026-02-03T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q_two",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "_environments": {
          "$unordered": [
            {
              "$unordered": [
                "$r1"
              ]
            },
            {
              "$unordered": [
                "$r3"
              ]
            }
          ]
        }
      }
    }
  ]
}
