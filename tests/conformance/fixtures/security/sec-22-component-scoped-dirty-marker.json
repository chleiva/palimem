{
  "version": 1,
  "kind": "scenario",
  "id": "sec-22-component-scoped-dirty-marker",
  "title": "Traversal-budget exhaustion marks only the affected dependency component",
  "gate": "G1",
  "area": "resource_limits",
  "status": "active",
  "covers": [
    "SEC-22",
    "T-20",
    "H4"
  ],
  "requires": [
    "budget_control"
  ],
  "spec_dependencies": [],
  "why": "Same set-up as ind-20, now the DECIDED behaviour (H4, reaffirmed by author ruling 15 of 2026-10-05): only the component whose closure could not be marked answers ResourceLimited; an unrelated key (site(bob)) keeps serving. A store-wide marker remains the last resort. Design row 20 as first written (store-wide) is superseded; ind-20 is reconciled with this.",
  "source": "docs/THREAT_MODEL.md §7 (SEC-22)",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      },
      "hq_city": {
        "class": "single_stable",
        "value_type": "entity",
        "inertia": false
      },
      "work_city": {
        "class": "derived",
        "value_type": "entity",
        "inertia": false,
        "rule": {
          "reads": [
            "employer",
            "hq_city"
          ],
          "fn": "work_city(e,c) <- employer(e,x), hq_city(x,c)"
        }
      },
      "local_tax_city": {
        "class": "derived",
        "value_type": "entity",
        "inertia": false,
        "rule": {
          "reads": [
            "work_city"
          ],
          "fn": "local_tax_city(e,c) <- work_city(e,c)"
        }
      },
      "site": {
        "class": "single_stable",
        "value_type": "string",
        "inertia": false
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "veltran"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "veltran",
          "attr": "hq_city"
        },
        "proposition": {
          "form": "value",
          "v": "tessaly"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r3",
      "at": "2026-02-03T10:00:00Z",
      "report": {
        "key": {
          "entity": "bob",
          "attr": "site"
        },
        "proposition": {
          "form": "value",
          "v": "north"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "configure",
      "limits": {
        "traversal_budget": 1
      }
    },
    {
      "op": "append",
      "ref": "r4",
      "at": "2026-02-10T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": null,
        "cue": "withdraw",
        "target": "$r1",
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q_dependant",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "local_tax_city"
        }
      },
      "expect": {
        "decision": "resource_limited",
        "reason": "store_dirty",
        "kernel_status": "$absent",
        "segment": "$absent",
        "assertion": "$absent"
      }
    },
    {
      "op": "query",
      "name": "q_unrelated",
      "query": {
        "key": {
          "entity": "bob",
          "attr": "site"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "north"
          }
        }
      }
    }
  ]
}
