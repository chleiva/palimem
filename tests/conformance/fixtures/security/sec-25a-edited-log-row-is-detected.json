{
  "version": 1,
  "kind": "scenario",
  "id": "sec-25a-edited-log-row-is-detected",
  "title": "Editing a log row directly is detected by verify_log, which names the first bad row",
  "gate": "G1",
  "area": "integrity",
  "status": "active",
  "covers": [
    "SEC-25",
    "T-23",
    "hash-chain-decision"
  ],
  "requires": [
    "hash_chain",
    "tamper_hook"
  ],
  "spec_dependencies": [],
  "why": "Hash chain (decided 2026-10-04, storage-layer): each log row carries prev_hash and a salted entry_hash. Editing the stored content of the second row breaks the chain from that row: verify_log over the whole log reports ok=false and names that row's LSN.",
  "source": "docs/THREAT_MODEL.md §7 (SEC-25)",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      }
    },
    "sources": {
      "directory": {
        "class": "standard",
        "origin_group": "g_directory"
      },
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r3",
      "at": "2026-02-03T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "directory",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_directory",
        "actor": "connector:directory",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "verify_log",
      "name": "v_ok",
      "expect": {
        "ok": true
      }
    },
    {
      "op": "tamper",
      "tamper": {
        "target": "log_row",
        "report": "$r2",
        "set": {
          "proposition": {
            "form": "value",
            "v": "globex"
          }
        }
      },
      "name": "tamper"
    },
    {
      "op": "verify_log",
      "name": "v_bad",
      "expect": {
        "ok": false,
        "first_bad_lsn": "$eq:$r2.lsn"
      }
    }
  ]
}
