{
  "version": 1,
  "kind": "scenario",
  "id": "sec-16-allege-flood-is-quota-limited",
  "title": "A flood of allege reports against one key hits a quota and changes nothing",
  "gate": "G1",
  "area": "security",
  "status": "pending-decision",
  "covers": [
    "SEC-16",
    "T-12"
  ],
  "requires": [
    "quotas"
  ],
  "spec_dependencies": [],
  "why": "1,000 unauthorised allege reports pointing at r1 must not drown the key. A per-source quota stops them well before 1,000; the answer for the key is unchanged (kernel_status, decision, inquiry), and the inquiry lists no allege text.",
  "source": "docs/THREAT_MODEL.md §7 (SEC-16)",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      }
    },
    "sources": {
      "forum": {
        "class": "low",
        "origin_group": "g_forum"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q_before",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      }
    },
    {
      "op": "append",
      "ref": "a{i}",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": null,
        "cue": "withdraw",
        "target": "$r1",
        "source": {
          "id": "forum",
          "class": "low"
        },
        "origin": "external_observation",
        "origin_group": "g_forum",
        "actor": "connector:forum",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      },
      "repeat": 1000
    },
    {
      "op": "reports",
      "name": "rep_a",
      "filter": {
        "cue": "allege"
      },
      "expect": {
        "count": {
          "$lt": 1000
        }
      }
    },
    {
      "op": "query",
      "name": "q_after",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "acme"
          }
        }
      }
    }
  ],
  "status_reason": "Threat-model mitigation T-12 (per-source quota on allege) is [proposed], not ratified (docs/THREAT_MODEL.md; gate G-S is a proposal).",
  "expect": {
    "equal": [
      {
        "a": "q_before",
        "b": "q_after",
        "fields": [
          "kernel_status",
          "decision",
          "inquiry"
        ]
      }
    ]
  }
}
