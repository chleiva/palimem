{
  "version": 1,
  "kind": "scenario",
  "id": "sec-26-restored-old-copy-is-detected",
  "title": "Restoring an older database copy is detected against an exported head hash",
  "gate": "G1",
  "area": "integrity",
  "status": "active",
  "covers": [
    "SEC-26",
    "T-24",
    "hash-chain-decision"
  ],
  "requires": [
    "backup_restore",
    "hash_chain"
  ],
  "spec_dependencies": [],
  "why": "A checkpoint is taken after r1; the chain head is exported after r2 (anchored outside the database). The database is then restored from the older checkpoint: the log is a valid chain, but its head no longer matches the anchored one, so verify_log with expected_head fails.",
  "source": "docs/THREAT_MODEL.md §7 (SEC-26)",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "checkpoint",
      "checkpoint_name": "c1",
      "name": "cp"
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "export_head",
      "name": "h1",
      "expect": {
        "head_hash": "$any"
      }
    },
    {
      "op": "restore_backup",
      "checkpoint_name": "c1",
      "name": "restore"
    },
    {
      "op": "verify_log",
      "name": "v",
      "expected_head": "$h1.head_hash",
      "expect": {
        "ok": false
      }
    }
  ]
}
