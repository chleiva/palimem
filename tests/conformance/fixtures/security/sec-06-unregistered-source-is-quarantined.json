    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      }
    },
    "sources": {}
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "mystery",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_mystery",
        "actor": "connector:mystery",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      },
      "expect": {
        "admission": {
          "outcome": "quarantined"
        }
      }
    },
    {
      "op": "query",
      "name": "q1",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "unknown",
        "_candidates": {
          "$len": 0
        }
      }
    }
