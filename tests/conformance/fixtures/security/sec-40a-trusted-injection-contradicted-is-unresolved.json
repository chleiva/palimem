{
  "version": 1,
  "kind": "scenario",
  "id": "sec-40a-trusted-injection-contradicted-is-unresolved",
  "title": "A trusted-source injection contradicted by another origin group is never established",
  "gate": "G1",
  "area": "poisoning",
  "status": "active",
  "covers": [
    "SEC-40",
    "T-17",
    "poisoning-gate-trusted"
  ],
  "requires": [],
  "spec_dependencies": [],
  "why": "Gate for the compromised-trusted-source case (decided 2026-10-04): the injected value must never become established while an admissible report from another origin group contradicts it. The press says Acme from 1 Jan; the (compromised) trusted registry says Globex from the same time with no cue: two different values at one anchor cannot both be true, so the key is unresolved with both candidates.",
  "source": "docs/THREAT_MODEL.md §7 (SEC-40)",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": "2026-01-01T00:00:00Z",
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-05T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "globex"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": "2026-01-01T00:00:00Z",
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q1",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "unresolved",
        "_candidates": {
          "$unordered": [
            {
              "form": {
                "form": "value",
                "v": "acme"
              }
            },
            {
              "form": {
                "form": "value",
                "v": "globex"
              }
            }
          ]
        }
      }
    }
  ]
}
