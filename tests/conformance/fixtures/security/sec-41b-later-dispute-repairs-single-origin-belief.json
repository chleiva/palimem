{
  "version": 1,
  "kind": "scenario",
  "id": "sec-41b-later-dispute-repairs-single-origin-belief",
  "title": "A later authorised dispute stops a single-origin belief from standing as established",
  "gate": "G1",
  "area": "poisoning",
  "status": "active",
  "covers": [
    "SEC-41",
    "T-17"
  ],
  "requires": [],
  "spec_dependencies": [
    "S-02: the kernel semantics of an authorised dispute is not defined in design v0.3; assumes the dispute plays the A-ERR competitor role."
  ],
  "why": "A user granted the dispute power on employer disputes r1 and states the competing value. The key can no longer be established on r1 alone: it is unresolved with both candidates; the single-origin belief does not survive the dispute.",
  "source": "docs/THREAT_MODEL.md §7 (SEC-41)",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      }
    },
    "sources": {
      "chat": {
        "class": "standard",
        "origin_group": "g_chat"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    },
    "authority": [
      {
        "who": {
          "kind": "principal",
          "value": "user:alice"
        },
        "may": [
          "dispute"
        ],
        "on": {
          "attr": "employer",
          "entity": "*"
        },
        "targets": "report",
        "over_origins": null
      }
    ]
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": "2026-01-01T00:00:00Z",
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-05T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "globex"
        },
        "cue": "dispute",
        "target": "$r1",
        "source": {
          "id": "chat",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_chat",
        "actor": "user:alice",
        "valid_from": "2026-01-01T00:00:00Z",
        "valid_to": null,
        "precision": "day"
      },
      "expect": {
        "recorded_cue": "dispute"
      }
    },
    {
      "op": "query",
      "name": "q1",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "unresolved",
        "_candidates": {
          "$unordered": [
            {
              "form": {
                "form": "value",
                "v": "acme"
              }
            },
            {
              "form": {
                "form": "value",
                "v": "globex"
              }
            }
          ]
        }
      }
    }
  ]
}
