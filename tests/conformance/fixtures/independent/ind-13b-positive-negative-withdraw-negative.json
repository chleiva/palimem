{
  "version": 1,
  "kind": "scenario",
  "id": "ind-13b-positive-negative-withdraw-negative",
  "title": "Positive and negative reports for one member; withdraw the negative one: the surviving report alone decides",
  "gate": "G1",
  "area": "negative_evidence",
  "status": "active",
  "covers": [
    "design-row-13",
    "S-04"
  ],
  "requires": [],
  "spec_dependencies": [
    "Whether member-only evidence under open completeness yields a determined set (established) or a weaker status is not settled by S-04; this fixture follows the design row ('the surviving one alone decides')."
  ],
  "why": "r1 (registry) says Acme is a member of alice's affiliations; r2 (press) says it is not. Admissible positive and negative evidence for the same member in overlapping valid time is unresolved with BOTH readings as candidates, never established_false: a denial is evidence against, not a veto. Withdrawing one of them (by its own source) leaves the other alone to decide: established with member acme.",
  "source": "design-v0.3 §Independent acceptance tests, row 13",
  "setup": {
    "profile": "open-world",
    "schema": {
      "affiliations": {
        "class": "multi_set",
        "value_type": "string",
        "inertia": false
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "affiliations"
        },
        "proposition": {
          "form": "member",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "affiliations"
        },
        "proposition": {
          "form": "not_member",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q_both",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "affiliations"
        }
      },
      "expect": {
        "kernel_status": "unresolved",
        "_candidates": {
          "$unordered": [
            {
              "form": {
                "form": "set",
                "values": [
                  "acme"
                ]
              }
            },
            {
              "form": {
                "form": "not_member",
                "v": "acme"
              }
            }
          ]
        }
      }
    },
    {
      "op": "append",
      "ref": "r3",
      "at": "2026-02-10T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "affiliations"
        },
        "proposition": null,
        "cue": "withdraw",
        "target": "$r2",
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q_after",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "affiliations"
        }
      },
      "expect": {
        "kernel_status": "established",
        "_candidates": {
          "$contains": {
            "form": {
              "form": "set",
              "values": [
                "acme"
              ]
            }
          }
        }
      }
    }
  ]
}
