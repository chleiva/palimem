{
  "version": 1,
  "kind": "scenario",
  "id": "ind-01-two-independent-supports-one-withdrawn",
  "title": "Two independent supports; one is withdrawn, the conclusion survives",
  "gate": "G1",
  "area": "retraction",
  "status": "active",
  "covers": [
    "design-row-1",
    "S-12"
  ],
  "requires": [],
  "spec_dependencies": [],
  "why": "work_city(alice) is derived from employer(alice) and hq_city(veltran). Two independent origin groups (press, directory) report employer=veltran, so the derived conclusion has two minimal environments over BASE reports: {r1,r3} and {r2,r3} (derivation pins are not evidence, S-12). Withdrawing r1 by its own source (authority default: the target's own source) removes only the environment containing r1, so the conclusion survives with exactly {r2,r3}. The pre-withdrawal answer is still served under belief_as_of = the LSN of r3.",
  "source": "design-v0.3 §Independent acceptance tests, row 1",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      },
      "hq_city": {
        "class": "single_stable",
        "value_type": "entity",
        "inertia": false
      },
      "work_city": {
        "class": "derived",
        "value_type": "entity",
        "inertia": false,
        "rule": {
          "reads": [
            "employer",
            "hq_city"
          ],
          "fn": "work_city(e,c) <- employer(e,x), hq_city(x,c)"
        }
      }
    },
    "sources": {
      "directory": {
        "class": "standard",
        "origin_group": "g_directory"
      },
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "veltran"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "veltran"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "directory",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_directory",
        "actor": "connector:directory",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r3",
      "at": "2026-02-03T10:00:00Z",
      "report": {
        "key": {
          "entity": "veltran",
          "attr": "hq_city"
        },
        "proposition": {
          "form": "value",
          "v": "tessaly"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q1",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "work_city"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "tessaly"
          }
        },
        "_environments": {
          "$unordered": [
            {
              "$unordered": [
                "$r1",
                "$r3"
              ]
            },
            {
              "$unordered": [
                "$r2",
                "$r3"
              ]
            }
          ]
        }
      }
    },
    {
      "op": "append",
      "ref": "r4",
      "at": "2026-02-10T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": null,
        "cue": "withdraw",
        "target": "$r1",
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      },
      "expect": {
        "recorded_cue": "withdraw"
      }
    },
    {
      "op": "query",
      "name": "q2",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "work_city"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "tessaly"
          }
        },
        "_environments": {
          "$unordered": [
            {
              "$unordered": [
                "$r2",
                "$r3"
              ]
            }
          ]
        },
        "justified": {
          "inference": {
            "complete": true
          }
        }
      }
    },
    {
      "op": "query",
      "name": "q3",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "work_city"
        },
        "belief_as_of": "$r3.lsn"
      },
      "expect": {
        "kernel_status": "established",
        "_environments": {
          "$unordered": [
            {
              "$unordered": [
                "$r1",
                "$r3"
              ]
            },
            {
              "$unordered": [
                "$r2",
                "$r3"
              ]
            }
          ]
        }
      }
    }
  ]
}
