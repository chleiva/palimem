{
  "version": 1,
  "kind": "scenario",
  "id": "ind-02-last-support-withdrawn-cascades",
  "title": "Last surviving support withdrawn: every unsupported downstream conclusion disappears",
  "gate": "G1",
  "area": "retraction",
  "status": "active",
  "covers": [
    "design-row-2"
  ],
  "requires": [],
  "spec_dependencies": [],
  "why": "employer(alice) has one report r1; work_city(alice) derives from it and hq_city(veltran); local_tax_city(alice) derives from work_city: a two-step chain. Withdrawing r1 leaves no admissible evidence for employer, so work_city and local_tax_city lose their only justification and become unknown (no candidates). hq_city(veltran) rests on r2, which is untouched, and stays established: only UNSUPPORTED conclusions disappear.",
  "source": "design-v0.3 §Independent acceptance tests, row 2",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      },
      "hq_city": {
        "class": "single_stable",
        "value_type": "entity",
        "inertia": false
      },
      "work_city": {
        "class": "derived",
        "value_type": "entity",
        "inertia": false,
        "rule": {
          "reads": [
            "employer",
            "hq_city"
          ],
          "fn": "work_city(e,c) <- employer(e,x), hq_city(x,c)"
        }
      },
      "local_tax_city": {
        "class": "derived",
        "value_type": "entity",
        "inertia": false,
        "rule": {
          "reads": [
            "work_city"
          ],
          "fn": "local_tax_city(e,c) <- work_city(e,c)"
        }
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "veltran"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "veltran",
          "attr": "hq_city"
        },
        "proposition": {
          "form": "value",
          "v": "tessaly"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q1",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "local_tax_city"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "tessaly"
          }
        }
      }
    },
    {
      "op": "append",
      "ref": "r3",
      "at": "2026-02-10T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": null,
        "cue": "withdraw",
        "target": "$r1",
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q2",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "unknown",
        "_candidates": {
          "$len": 0
        }
      }
    },
    {
      "op": "query",
      "name": "q3",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "work_city"
        }
      },
      "expect": {
        "kernel_status": "unknown",
        "_candidates": {
          "$len": 0
        }
      }
    },
    {
      "op": "query",
      "name": "q4",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "local_tax_city"
        }
      },
      "expect": {
        "kernel_status": "unknown",
        "_candidates": {
          "$len": 0
        }
      }
    },
    {
      "op": "query",
      "name": "q5",
      "query": {
        "key": {
          "entity": "veltran",
          "attr": "hq_city"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "tessaly"
          }
        },
        "_environments": {
          "$unordered": [
            {
              "$unordered": [
                "$r2"
              ]
            }
          ]
        }
      }
    }
  ]
}
