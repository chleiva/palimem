{
  "version": 1,
  "kind": "scenario",
  "id": "ind-15-attributed-twice-content-unknown",
  "title": "Two independent reports that Alice believes P: belief_of(Alice,P) established; P stays unknown",
  "gate": "G1",
  "area": "attribution",
  "status": "active",
  "covers": [
    "design-row-15",
    "S-11"
  ],
  "requires": [],
  "spec_dependencies": [
    "Query has no selector for 'the attribution' versus 'the content'; this fixture reads both from the candidate list of the one key. S-11 should say how a caller asks for each."
  ],
  "why": "Two attributed reports from different origin groups say that alice believes bob works for acme. Attributed reports are admissible as evidence for the attribution only, however many groups corroborate: belief_of(alice, value(acme)) is established (two minimal environments {r1} and {r2}); the content, bob's employer = acme, is never asserted and no value(acme) candidate exists.",
  "source": "design-v0.3 §Independent acceptance tests, row 15",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      }
    },
    "sources": {
      "directory": {
        "class": "standard",
        "origin_group": "g_directory"
      },
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "bob",
          "attr": "employer"
        },
        "proposition": {
          "form": "belief_of",
          "holder": "alice",
          "proposition": {
            "form": "value",
            "v": "acme"
          }
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "attributed",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "bob",
          "attr": "employer"
        },
        "proposition": {
          "form": "belief_of",
          "holder": "alice",
          "proposition": {
            "form": "value",
            "v": "acme"
          }
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "directory",
          "class": "standard"
        },
        "origin": "attributed",
        "origin_group": "g_directory",
        "actor": "connector:directory",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q1",
      "query": {
        "key": {
          "entity": "bob",
          "attr": "employer"
        }
      },
      "expect": {
        "_candidates": {
          "$contains": {
            "form": {
              "form": "belief_of",
              "holder": "alice",
              "proposition": {
                "form": "value",
                "v": "acme"
              }
            }
          }
        },
        "_environments": {
          "$unordered": [
            {
              "$unordered": [
                "$r1"
              ]
            },
            {
              "$unordered": [
                "$r2"
              ]
            }
          ]
        }
      }
    },
    {
      "op": "query",
      "name": "q2",
      "query": {
        "key": {
          "entity": "bob",
          "attr": "employer"
        }
      },
      "expect": {
        "_candidates": {
          "$none": {
            "form": {
              "form": "value",
              "v": "acme"
            }
          }
        }
      }
    }
  ]
}
