{
  "version": 1,
  "kind": "scenario",
  "id": "ind-14-cascade-budget-stale-c",
  "title": "Revision budget exhausted on A to B to C before C is visited: C is resource_limited until its job runs",
  "gate": "G1",
  "area": "resource_limits",
  "status": "active",
  "covers": [
    "design-row-14",
    "S-06"
  ],
  "requires": [
    "budget_control",
    "completion_jobs"
  ],
  "spec_dependencies": [
    "Budget names (revision_budget, traversal_budget) are fixture vocabulary: the design does not name its budgets."
  ],
  "why": "Chain A=employer, B=work_city, C=local_tax_city. The per-append revision budget is 2 keys. Withdrawing the only employer report recomputes A and B but the budget is exhausted before C is visited, so C is stale (completed_generation < required_generation). Reads of C return ResourceLimited(stale_dependency) naming C, with no kernel_status, no segment and no assertion: the old C (Tessaly) is never served as current. A and B are resolved (unknown). After the completion job runs, C resolves to unknown. NOTE: the design says 'visited' for both marking and recomputation; this fixture takes it as the per-append recomputation budget ('revision_budget') and keeps the marking (traversal) budget for row 20.",
  "source": "design-v0.3 §Independent acceptance tests, row 14",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      },
      "hq_city": {
        "class": "single_stable",
        "value_type": "entity",
        "inertia": false
      },
      "work_city": {
        "class": "derived",
        "value_type": "entity",
        "inertia": false,
        "rule": {
          "reads": [
            "employer",
            "hq_city"
          ],
          "fn": "work_city(e,c) <- employer(e,x), hq_city(x,c)"
        }
      },
      "local_tax_city": {
        "class": "derived",
        "value_type": "entity",
        "inertia": false,
        "rule": {
          "reads": [
            "work_city"
          ],
          "fn": "local_tax_city(e,c) <- work_city(e,c)"
        }
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "veltran"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "veltran",
          "attr": "hq_city"
        },
        "proposition": {
          "form": "value",
          "v": "tessaly"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q_c0",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "local_tax_city"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "tessaly"
          }
        }
      }
    },
    {
      "op": "configure",
      "limits": {
        "revision_budget": 2
      }
    },
    {
      "op": "append",
      "ref": "r3",
      "at": "2026-02-10T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": null,
        "cue": "withdraw",
        "target": "$r1",
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q_a",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "unknown",
        "_candidates": {
          "$len": 0
        }
      }
    },
    {
      "op": "query",
      "name": "q_b",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "work_city"
        }
      },
      "expect": {
        "kernel_status": "unknown",
        "_candidates": {
          "$len": 0
        }
      }
    },
    {
      "op": "query",
      "name": "q_c",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "local_tax_city"
        }
      },
      "expect": {
        "decision": "resource_limited",
        "reason": "stale_dependency",
        "kernel_status": "$absent",
        "segment": "$absent",
        "assertion": "$absent",
        "reason_key": {
          "entity": "alice",
          "attr": "local_tax_city"
        }
      }
    },
    {
      "op": "complete_jobs",
      "name": "jobs",
      "expect": {
        "completed": {
          "$contains": {
            "entity": "alice",
            "attr": "local_tax_city"
          }
        }
      }
    },
    {
      "op": "query",
      "name": "q_c_done",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "local_tax_city"
        }
      },
      "expect": {
        "kernel_status": "unknown",
        "_candidates": {
          "$len": 0
        }
      }
    }
  ]
}
