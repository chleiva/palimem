{
  "version": 1,
  "kind": "scenario",
  "id": "ind-10-deletion-with-dependants",
  "title": "Deletion of a report with dependants: content gone, tombstone present, dependants repaired",
  "gate": "G1",
  "area": "deletion",
  "status": "active",
  "covers": [
    "design-row-10",
    "S-13"
  ],
  "requires": [
    "delete"
  ],
  "spec_dependencies": [],
  "why": "Deletion (an erasure obligation) removes the report's content and raw reference but, unlike withdrawal, also from the log's readable content; it triggers the same dependency repair as a withdrawal. After deleting r1, the stored row has no proposition and no raw_ref, a tombstone (id, actor, reason) exists, work_city that depended on r1 is repaired to unknown, and the delete returns an erasure report listing what can no longer be reconstructed.",
  "source": "design-v0.3 §Independent acceptance tests, row 10",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      },
      "hq_city": {
        "class": "single_stable",
        "value_type": "entity",
        "inertia": false
      },
      "work_city": {
        "class": "derived",
        "value_type": "entity",
        "inertia": false,
        "rule": {
          "reads": [
            "employer",
            "hq_city"
          ],
          "fn": "work_city(e,c) <- employer(e,x), hq_city(x,c)"
        }
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "veltran"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day",
        "raw_ref": "blob:r1"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "veltran",
          "attr": "hq_city"
        },
        "proposition": {
          "form": "value",
          "v": "tessaly"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q_before",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "work_city"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "tessaly"
          }
        }
      }
    },
    {
      "op": "delete",
      "target": "$r1",
      "actor": "system:admin",
      "reason": "erasure_request",
      "at": "2026-02-10T10:00:00Z",
      "name": "del",
      "expect": {
        "tombstone": {
          "id": "$r1",
          "actor": "system:admin",
          "reason": "erasure_request"
        },
        "erasure_report": "$any"
      }
    },
    {
      "op": "reports",
      "name": "rep_r1",
      "filter": {
        "id": "$r1"
      },
      "expect": {
        "rows": [
          {
            "tombstone": true,
            "proposition": "$absent",
            "raw_ref": "$absent"
          }
        ]
      }
    },
    {
      "op": "query",
      "name": "q_work",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "work_city"
        }
      },
      "expect": {
        "kernel_status": "unknown",
        "_candidates": {
          "$len": 0
        }
      }
    },
    {
      "op": "query",
      "name": "q_emp",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "unknown",
        "_candidates": {
          "$len": 0
        }
      }
    }
  ]
}
