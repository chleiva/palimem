{
  "version": 1,
  "kind": "scenario",
  "id": "ind-17-outbox-redelivery-after-crash",
  "title": "Crash after a belief change commits, before the subscriber is notified: re-delivered with the same event id",
  "gate": "G2",
  "area": "outbox",
  "status": "active",
  "covers": [
    "design-row-17",
    "E2.5"
  ],
  "requires": [
    "crash_injection",
    "outbox"
  ],
  "spec_dependencies": [],
  "why": "A plan subscribes to employer(alice). A correction changes the belief and the process dies after the revision transaction committed (the outbox row is part of that transaction) but before the notification was sent. After recovery the event is delivered from the outbox. The subscriber then crashes before acknowledging, so a second delivery carries the SAME event_id (at least once). The runner's reference subscriber is idempotent on event_id: it saw two deliveries but applied one effect. After the ack nothing is redelivered.",
  "source": "design-v0.3 §Independent acceptance tests, row 17",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      }
    },
    "sources": {
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "subscribe",
      "plan_id": "p1",
      "keys": [
        {
          "entity": "alice",
          "attr": "employer"
        }
      ],
      "name": "sub"
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-10T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "globex"
        },
        "cue": "correct",
        "target": "$r1",
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      },
      "crash": {
        "point": "after_commit_before_notify"
      },
      "expect": {
        "crashed": true
      }
    },
    {
      "op": "recover",
      "name": "rec",
      "expect": {
        "recovered": true
      }
    },
    {
      "op": "deliver",
      "name": "d1",
      "expect": {
        "events": [
          {
            "plan_id": "p1",
            "event_id": "$any",
            "key": {
              "entity": "alice",
              "attr": "employer"
            }
          }
        ]
      }
    },
    {
      "op": "crash",
      "point": "after_delivery_before_ack",
      "name": "crash2"
    },
    {
      "op": "recover",
      "name": "rec2"
    },
    {
      "op": "deliver",
      "name": "d2",
      "expect": {
        "events": [
          {
            "plan_id": "p1",
            "event_id": "$eq:$d1.events.0.event_id"
          }
        ]
      }
    },
    {
      "op": "ack",
      "from": "d2",
      "name": "ack1"
    },
    {
      "op": "deliver",
      "name": "d3",
      "expect": {
        "events": {
          "$len": 0
        }
      }
    },
    {
      "op": "subscriber_effects",
      "name": "fx",
      "expect": {
        "p1": {
          "events_seen": 2,
          "effects_applied": 1
        }
      }
    }
  ]
}
