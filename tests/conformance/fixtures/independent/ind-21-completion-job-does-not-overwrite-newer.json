{
  "version": 1,
  "kind": "scenario",
  "id": "ind-21-completion-job-does-not-overwrite-newer",
  "title": "A completion job for generation g that runs after g+1 completed the same key does not overwrite it",
  "gate": "G1",
  "area": "resource_limits",
  "status": "active",
  "covers": [
    "design-row-21",
    "S-06"
  ],
  "requires": [
    "budget_control",
    "completion_jobs"
  ],
  "spec_dependencies": [],
  "why": "Two derived keys read employer(alice): work_city (also reads hq_city) and badge_site (also reads site). At generation g a correction changes the employer to globex with a revision budget of 1, so both derived keys are marked but incomplete. At generation g+1 (budget raised) a new hq_city(globex)=paris report recomputes work_city completely: paris, completed for g+1. badge_site is still stale at g. Running the job for g finishes badge_site (now unknown: no site for globex) and must NOT touch work_city: it would overwrite paris with the g-state answer (unknown). work_city keeps its version and stays paris.",
  "source": "design-v0.3 §Independent acceptance tests, row 21",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      },
      "hq_city": {
        "class": "single_stable",
        "value_type": "entity",
        "inertia": false
      },
      "site": {
        "class": "single_stable",
        "value_type": "string",
        "inertia": false
      },
      "work_city": {
        "class": "derived",
        "value_type": "entity",
        "inertia": false,
        "rule": {
          "reads": [
            "employer",
            "hq_city"
          ],
          "fn": "work_city(e,c) <- employer(e,x), hq_city(x,c)"
        }
      },
      "badge_site": {
        "class": "derived",
        "value_type": "string",
        "inertia": false,
        "rule": {
          "reads": [
            "employer",
            "site"
          ],
          "fn": "badge_site(e,s) <- employer(e,x), site(x,s)"
        }
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "veltran"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "veltran",
          "attr": "hq_city"
        },
        "proposition": {
          "form": "value",
          "v": "tessaly"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r3",
      "at": "2026-02-03T10:00:00Z",
      "report": {
        "key": {
          "entity": "veltran",
          "attr": "site"
        },
        "proposition": {
          "form": "value",
          "v": "north"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q_b0",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "work_city"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "tessaly"
          }
        }
      }
    },
    {
      "op": "configure",
      "limits": {
        "revision_budget": 1
      }
    },
    {
      "op": "append",
      "ref": "r4",
      "at": "2026-02-10T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "globex"
        },
        "cue": "correct",
        "target": "$r1",
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "configure",
      "limits": {
        "revision_budget": 100
      }
    },
    {
      "op": "append",
      "ref": "r5",
      "at": "2026-02-11T10:00:00Z",
      "report": {
        "key": {
          "entity": "globex",
          "attr": "hq_city"
        },
        "proposition": {
          "form": "value",
          "v": "paris"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "query",
      "name": "q_b1",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "work_city"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "paris"
          }
        },
        "justified": {
          "completed_generation": "$r5.generation"
        }
      }
    },
    {
      "op": "query",
      "name": "q_c1",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "badge_site"
        }
      },
      "expect": {
        "decision": "resource_limited",
        "reason": "stale_dependency",
        "kernel_status": "$absent",
        "segment": "$absent",
        "assertion": "$absent",
        "reason_key": {
          "entity": "alice",
          "attr": "badge_site"
        }
      }
    },
    {
      "op": "complete_jobs",
      "generation": "$r4.generation",
      "name": "job_g",
      "expect": {
        "completed": {
          "$contains": {
            "entity": "alice",
            "attr": "badge_site"
          }
        },
        "skipped": {
          "$contains": {
            "entity": "alice",
            "attr": "work_city"
          }
        }
      }
    },
    {
      "op": "query",
      "name": "q_b2",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "work_city"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "paris"
          }
        },
        "justified": {
          "completed_generation": "$r5.generation"
        }
      }
    },
    {
      "op": "query",
      "name": "q_c2",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "badge_site"
        }
      },
      "expect": {
        "kernel_status": "unknown",
        "_candidates": {
          "$len": 0
        }
      }
    }
  ],
  "expect": {
    "equal": [
      {
        "a": "q_b1",
        "b": "q_b2",
        "fields": [
          "justified.version",
          "justified.completed_generation",
          "assertion"
        ]
      }
    ]
  }
}
