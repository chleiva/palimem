{
  "version": 1,
  "kind": "scenario",
  "id": "ind-07-crash-between-append-and-index",
  "title": "Crash between append and index update, then retry: no duplicate, no partial revision",
  "gate": "G1",
  "area": "crash_recovery",
  "status": "active",
  "covers": [
    "design-row-7",
    "E1.4"
  ],
  "requires": [
    "crash_injection"
  ],
  "spec_dependencies": [],
  "why": "The process dies in the middle of the append transaction. The write is transactional (report, admission record, belief versions, generation and index become visible together or not at all), so after recovery there is no report and no belief. A retry with the same idempotency key then lands exactly once; a second retry with the same key is a duplicate and returns the same report id.",
  "source": "design-v0.3 §Independent acceptance tests, row 7",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      }
    },
    "sources": {
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1x",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      },
      "idempotency_key": "k1",
      "crash": {
        "point": "mid_transaction"
      },
      "expect": {
        "crashed": true
      }
    },
    {
      "op": "recover",
      "name": "rec",
      "expect": {
        "recovered": true
      }
    },
    {
      "op": "reports",
      "name": "rep_none",
      "filter": {},
      "expect": {
        "count": 0
      }
    },
    {
      "op": "query",
      "name": "q_none",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "unknown",
        "_candidates": {
          "$len": 0
        }
      }
    },
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      },
      "idempotency_key": "k1",
      "expect": {
        "duplicate": false,
        "admission": {
          "outcome": "admissible"
        }
      }
    },
    {
      "op": "append",
      "ref": "r1b",
      "at": "2026-02-02T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      },
      "idempotency_key": "k1",
      "expect": {
        "duplicate": true,
        "report_id": "$eq:$r1"
      }
    },
    {
      "op": "reports",
      "name": "rep_one",
      "filter": {},
      "expect": {
        "count": 1
      }
    },
    {
      "op": "query",
      "name": "q_one",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "acme"
          }
        },
        "_environments": {
          "$unordered": [
            {
              "$unordered": [
                "$r1"
              ]
            }
          ]
        }
      }
    }
  ]
}
