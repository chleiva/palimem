{
  "version": 1,
  "kind": "scenario",
  "id": "ind-05-unauthorised-withdrawal-rejected",
  "title": "Unauthorised withdrawal is rejected at the authority check; a dispute is logged",
  "gate": "G1",
  "area": "authority",
  "status": "active",
  "covers": [
    "design-row-5",
    "S-02",
    "S-03"
  ],
  "requires": [],
  "spec_dependencies": [],
  "why": "The registry asserts r1. The press (a different source, actor and origin group) tries to withdraw it. Default authority is the target's own source (S-02), so the check fails: the report is recorded with cue allege (no effect on admissibility; admission reason authority_failed). r1 stays effective: employer is still established Acme with environment {r1}, and r1 is not marked withdrawn. The 'dispute logged' of the design row is the allege row that points at r1.",
  "source": "design-v0.3 §Independent acceptance tests, row 5",
  "setup": {
    "profile": "open-world",
    "schema": {
      "employer": {
        "class": "single_changeable",
        "value_type": "entity",
        "inertia": true
      }
    },
    "sources": {
      "press": {
        "class": "standard",
        "origin_group": "g_press"
      },
      "registry": {
        "class": "trusted",
        "origin_group": "g_registry"
      }
    }
  },
  "ops": [
    {
      "op": "append",
      "ref": "r1",
      "at": "2026-02-01T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": {
          "form": "value",
          "v": "acme"
        },
        "cue": "assert",
        "target": null,
        "source": {
          "id": "registry",
          "class": "trusted"
        },
        "origin": "external_observation",
        "origin_group": "g_registry",
        "actor": "connector:registry",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      }
    },
    {
      "op": "append",
      "ref": "r2",
      "at": "2026-02-05T10:00:00Z",
      "report": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        },
        "proposition": null,
        "cue": "withdraw",
        "target": "$r1",
        "source": {
          "id": "press",
          "class": "standard"
        },
        "origin": "external_observation",
        "origin_group": "g_press",
        "actor": "connector:press",
        "valid_from": null,
        "valid_to": null,
        "precision": "day"
      },
      "expect": {
        "recorded_cue": "allege",
        "admission": {
          "reason": "authority_failed"
        }
      }
    },
    {
      "op": "query",
      "name": "q1",
      "query": {
        "key": {
          "entity": "alice",
          "attr": "employer"
        }
      },
      "expect": {
        "kernel_status": "established",
        "assertion": {
          "form": {
            "form": "value",
            "v": "acme"
          }
        },
        "_environments": {
          "$unordered": [
            {
              "$unordered": [
                "$r1"
              ]
            }
          ]
        }
      }
    },
    {
      "op": "reports",
      "name": "rep_allege",
      "filter": {
        "cue": "allege"
      },
      "expect": {
        "count": 1,
        "rows": [
          {
            "target": "$r1",
            "actor": "connector:press"
          }
        ]
      }
    },
    {
      "op": "reports",
      "name": "rep_r1",
      "filter": {
        "id": "$r1"
      },
      "expect": {
        "rows": [
          {
            "withdrawn": false
          }
        ]
      }
    }
  ]
}
